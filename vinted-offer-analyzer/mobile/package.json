{
  "name": "offerta-vinted-timing-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "description": "App Android (Expo) dell'analizzatore di offerte Vinted: motore condiviso, lista da comprare, notifiche e calendario.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "sync-core": "node scripts/sync-core.mjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "export:android": "expo export --platform android --output-dir .export-check",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-calendar": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  }
}
